<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App metadata -->
    <key>CFBundleName</key>
    <string>Silent Disco</string>
    <key>CFBundleDisplayName</key>
    <string>Silent Disco</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict/>

    <!-- Background audio — keeps music playing when screen locks -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>

    <!-- Camera access for QR scanning -->
    <key>NSCameraUsageDescription</key>
    <string>Used to scan QR codes to copy event settings from another device.</string>

    <!-- Apple Music / MusicKit -->
    <key>NSAppleMusicUsageDescription</key>
    <string>Used to play synced playlists during the silent disco.</string>

    <!-- Local file access -->
    <key>NSDocumentsFolderUsageDescription</key>
    <string>Used to import and store audio files for offline playback.</string>

    <!-- Spotify URL scheme (for App Remote auth redirect) -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>Spotify Auth Redirect</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>silentdisco</string>
            </array>
        </dict>
    </array>

    <!-- Allows connecting to Spotify app -->
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>spotify</string>
    </array>

    <!-- Supported orientations -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
</dict>
</plist>
