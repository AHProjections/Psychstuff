<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required: app name shown on watch face -->
    <key>CFBundleDisplayName</key>
    <string>Haptic Timer</string>

    <!-- Required: background mode for WKExtendedRuntimeSession (self-care type) -->
    <key>WKBackgroundModes</key>
    <array>
        <string>self-care</string>
    </array>

    <!-- Declare this is a standalone watch app (no iOS companion required) -->
    <key>WKWatchOnly</key>
    <true/>

    <!-- Minimum watchOS version -->
    <key>MinimumOSVersion</key>
    <string>8.0</string>
</dict>
</plist>
